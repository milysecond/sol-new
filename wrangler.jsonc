{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sol-new",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "4e8d1e0f981ddd5939a1e74aa536d38b",
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "NEXT_PUBLIC_ONRAMP_ENABLED": "1",
    "CROSSMINT_PROJECT_ID": "659bb4f5-36d6-49a6-aee0-acedfd4eabf0"
  },
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "sol-new-images"
    }
  ]
  // TODO: re-add `"triggers": { "crons": ["0 17 * * *"] }` once we have a
  // custom worker entry that wraps OpenNext and adds a `scheduled` handler
  // for /api/cron/reengage. OpenNext's default worker.js only exports fetch.
}
