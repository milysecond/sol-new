# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
.env*.local

# dApp store build artifacts (APK + media + bubblewrap output)
dapp-store/media/
dapp-store/*.apk
dapp-store/*.aab
dapp-store/*.keystore
dapp-store/.bubblewrap/
dapp-store/app/
dapp-store/build/
dapp-store/android.keystore
